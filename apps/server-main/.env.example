PORT=3000


#Docs
DOCS_ENABLED=true
DOCS_PATH=docs

#Bullboard
BULLBOARD_ENABLED=true
BULLBOARD_PATH=/queues

# Database
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/NAME?schema=public
DATABASE_LOGGING=true


# Redis
REDIS_HOST=host
REDIS_PORT=6379


# SMTP configuration
SMTP_HOST=host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user
SMTP_PASS=password


# Sender email
MAIL_SENDER=example@mail.com


# Weather API key from weatherapi.com
WEATHER_API_KEY=YOUR_API_KEY